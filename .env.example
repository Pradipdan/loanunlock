APP_NAME=LoanUnlock
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loanunlock
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@loanunlock.com"
MAIL_FROM_NAME="${APP_NAME}"

# Razorpay / Payment Gateway
RAZORPAY_KEY=rzp_test_your_key_here
RAZORPAY_SECRET=your_secret_here
PROCESSING_FEE=299

# OTP (Twilio or MSG91)
OTP_PROVIDER=demo
MSG91_AUTH_KEY=your_msg91_key_here
MSG91_SENDER_ID=LNUNLK

ADMIN_EMAIL=admin@loanunlock.com
ADMIN_PASSWORD=Admin@123
